
action "aegis_project_batch_settled" "svm::deploy_subgraph" {
    program_id = action.deploy_aegis_project.program_id
    program_idl = action.deploy_aegis_project.program_idl
    block_height = 0 // action.deploy_aegis_project.block_height
    event {
        name = "BatchSettled"
    }
}

